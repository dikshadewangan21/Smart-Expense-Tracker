# Backend (backend/.env). Never commit real values.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/expense_tracker
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
FRONTEND_ORIGIN=http://localhost:5173
# Set to false only for local http development
COOKIE_SECURE=true

# Demo mode: lets the reserved demo account sign in (python -m app.seed.demo seed). Leave false in production.
ENABLE_DEMO=false

# Optional: run the test suite against PostgreSQL instead of in-memory SQLite (tables are truncated!)
# TEST_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/expense_tracker_test

# AI provider (optional; AI endpoints are disabled until configured): anthropic | openai | gemini
AI_PROVIDER=
AI_API_KEY=
# Receipt OCR provider (optional)
OCR_PROVIDER=
OCR_API_KEY=

# Frontend (frontend/.env). Leave VITE_API_URL empty to use the same-origin proxy/rewrite.
VITE_API_URL=
VITE_BACKEND_URL=http://localhost:8000
